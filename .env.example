# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://bbb:bbb@localhost:5437/bbb

# better-auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# api
PORT=3001
DASHBOARD_URL=http://localhost:5173

# email (Resend) — leave blank locally; magic links/change-email links just
# print to the console instead of sending. Only needed in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# only set in production, where the API and dashboard live on different
# subdomains of the same domain (e.g. .bancroftbrewbowl.ca)
COOKIE_DOMAIN=

# dashboard (Vite exposes only VITE_-prefixed vars to the client)
VITE_API_URL=http://localhost:3001
