{
  "name": "bancroftbrewbowl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @bbb/api dev",
    "dev:dashboard": "pnpm --filter @bbb/dashboard dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @bbb/shared build",
    "lint": "eslint .",
    "pretypecheck": "pnpm run build:packages",
    "typecheck": "pnpm -r run typecheck",
    "pretest": "pnpm run build:packages",
    "test": "vitest run",
    "db:generate": "pnpm --filter @bbb/api db:generate",
    "db:migrate": "pnpm --filter @bbb/api db:migrate",
    "db:push": "pnpm --filter @bbb/api db:push",
    "db:studio": "pnpm --filter @bbb/api db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "railway": "^3.11.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
